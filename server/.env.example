# ---- RoleFit AI Express API (copy to server/.env) ----
NODE_ENV=development
HOST=127.0.0.1
PORT=5000

# Local MongoDB Community Server, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/rolefit

# Comma-separated list of browser origins allowed to call the API (CORS + CSRF + WebSocket origin check).
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session cookie settings. Use COOKIE_SAMESITE=none (requires HTTPS) only if the
# frontend and API are on different sites. Same-site deployments should keep "lax".
SESSION_TTL_HOURS=12
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   # defaults to true in production

# Optional Python AI service (FastAPI in ../backend). Must match AI_SERVICE_TOKEN in backend/.env.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=change-me-to-a-long-random-string
AI_SERVICE_TIMEOUT_MS=60000

# Serve the built React app from Express (single-origin production deployment).
SERVE_CLIENT=false
CLIENT_DIST=../frontend/dist
# Number of reverse proxies in front of the app (e.g. 1 on Render/Heroku) so rate limiting sees real IPs.
TRUST_PROXY=0
