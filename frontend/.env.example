# Leave VITE_API_URL empty for local development: Vite proxies /api and /ws to Express.
# Set it only when the built frontend is hosted on a different origin than the API
# (then the API needs CLIENT_ORIGINS, COOKIE_SAMESITE=none and HTTPS).
VITE_API_URL=
# Base path the app is served from ("/" locally, "/RoleFit-AI/" for GitHub Pages).
VITE_BASE=/
# Dev-only: where the Vite proxy forwards /api and /ws.
VITE_DEV_API_TARGET=http://127.0.0.1:5000
