# ---- RoleFit AI internal AI service (copy to backend/.env) ----
# Never commit a real key. The browser never receives it: Express calls this service.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Comma-separated models tried in order when the primary times out or returns 429/5xx.
GEMINI_TEXT_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_VOICE=Aoede

# Shared secret: must equal AI_SERVICE_TOKEN in server/.env. When set, only
# requests carrying it (i.e. from Express) are accepted on /api/* and /ws/*.
AI_SERVICE_TOKEN=change-me-to-a-long-random-string

# Bind to localhost so only the Express API on this machine can reach the service.
HOST=127.0.0.1
PORT=8000

EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=50000
# Gemini HTTP client: separate connect/read timeouts and bounded retries for
# 429/5xx/timeouts (exponential backoff + jitter, honours Retry-After).
# Keep the total below server/.env AI_SERVICE_TIMEOUT_MS (60000 by default).
GEMINI_CONNECT_TIMEOUT_SECONDS=5
GEMINI_READ_TIMEOUT_SECONDS=25
GEMINI_TOTAL_TIMEOUT_SECONDS=50
GEMINI_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
